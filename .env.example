# --- Email delivery for pilot applications -------------------------------------
# Veil uses Resend (https://resend.com) to email each application to you.
# 1. Create a free Resend account and an API key.
# 2. (Production) verify your sending domain in Resend, then set APPLY_FROM_EMAIL
#    to an address on that domain. For a quick test you can keep the sandbox
#    sender below (onboarding@resend.dev) — it only delivers to the Resend
#    account owner's email.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where pilot applications are delivered:
APPLY_TO_EMAIL=esantoz@protonmail.com

# Verified sender (swap to your own domain for production):
APPLY_FROM_EMAIL=Veil Pilot <onboarding@resend.dev>